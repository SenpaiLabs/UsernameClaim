# Get these at https://my.telegram.org -> API development tools
API_ID=
API_HASH=

# Channel you own: @username, invite link or numeric ID
CHANNEL=

# Who receives notifications and can send commands ("me" = Saved Messages, or a numeric user ID)
OWNER_ID=me

# Optional: control commands from a Telegram bot (create one with @BotFather).
# Needs OWNER_ID to be your numeric user ID. Send /start to the bot once.
BOT_TOKEN=

# Seconds between full checks of the list (keep >= 20 to avoid flood limits)
CHECK_INTERVAL=30
