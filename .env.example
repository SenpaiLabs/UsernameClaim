# Get these at https://my.telegram.org -> API development tools
API_ID=
API_HASH=

# Channel to put the username on: @username, invite link or numeric ID.
# Leave EMPTY to let the bot create a channel itself.
CHANNEL=

# Title of the channel the bot creates when CHANNEL is empty
CHANNEL_TITLE=My Channel

# Who receives notifications and can send commands ("me" = Saved Messages, or a numeric user ID)
OWNER_ID=me

# Seconds between full checks of the list (keep >= 20 to avoid flood limits)
CHECK_INTERVAL=30
